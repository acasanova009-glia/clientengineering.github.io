{
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
  "build:analyzer": "./node_modules/esbuild/bin/esbuild --bundle --minify --format=esm --outfile=analyzer-out.js --target=es2020 analyzer-function.js",
  "build:gateway": "./node_modules/esbuild/bin/esbuild --bundle --minify --format=esm --outfile=gateway-out.js --target=es2020 gateway-function.js",
  "build": "npm run build:analyzer && npm run build:gateway"
  },
  "dependencies": {
    "axios": "^1.21.1"
  }
}
